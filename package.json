{
  "name": "admitto",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme LL.M. & Barreau américain — système personnalisé de décision, planification et exécution.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:legal": "node scripts/check-legal.mjs",
    "verify:animations": "node scripts/verify-animations.mjs",
    "verify:questionnaire": "node scripts/verify-questionnaire.mjs",
    "verify:backoffice": "node scripts/verify-backoffice.mjs",
    "verify:checkout": "node scripts/verify-checkout.mjs",
    "verify:dashboard": "node scripts/verify-dashboard.mjs",
    "verify:simulator": "node scripts/verify-simulator.mjs",
    "verify:espace": "node scripts/verify-espace.mjs",
    "verify:consultations": "node scripts/verify-consultations.mjs",
    "verify:legal": "node scripts/verify-legal.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "report:pdf": "node scripts/render-report-pdf.mjs",
    "import:partnerships": "node scripts/import-partnerships.mjs",
    "check:all": "npm run lint && npm run typecheck && npm run test && npm run check:vocabulary && npm run check:tokens && npm run check:rules && npm run check:skills && npm run check:legal",
    "graph:build": "graphify . || echo 'graphify non installé — voir docs/TOKEN_OPTIMIZATION.md'",
    "graph:update": "graphify . --update || echo 'graphify non installé — voir docs/TOKEN_OPTIMIZATION.md'",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.62.0",
    "prettier": "^3.3.0",
    "prisma": "^6.19.3",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
