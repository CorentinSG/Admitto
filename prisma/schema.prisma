// Schéma Prisma — Admitto (PLAN.md §4).
//
// Remplace les stores en mémoire accrochés à globalThis. Deux principes ont
// guidé la modélisation :
//
// 1. **Le profil est stocké tel qu'il a été répondu.** `answers` et `derived`
//    sont des colonnes JSON : les recalculer à la lecture ferait qu'un rapport
//    rouvert six mois plus tard s'appuierait sur des règles ou des barèmes qui
//    ont changé depuis. `rulesSnapshot` fige déjà la version des règles ; la
//    même logique s'applique aux réponses.
//
// 2. **Ce que le code garantit déjà n'est pas relâché en base.** Les listes
//    fermées du CDC (statuts, voies, types de document, types de séance)
//    restent des unions TypeScript et sont stockées en `String` : dupliquer
//    ces listes en `enum` Prisma créerait deux sources de vérité, dont une
//    qui ne serait pas contrôlée par `check:vocabulary` ni par les tests.
//    L'intégrité vient des types à l'écriture, pas d'un enum de plus.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Compte utilisateur (CDC §10 et §33).
///
/// Le rôle est une colonne, pas une liste d'emails lue à chaque requête : un
/// accès au back-office doit être révocable en base, et traçable. La variable
/// `ADMITTO_ADMIN_EMAILS` ne sert qu'à l'amorçage du premier administrateur —
/// sans elle, personne n'est administrateur, et le back-office reste fermé.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String    @default("CLIENT")
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  assessments Assessment[]
}

/// Comptes liés (Auth.js). Aucun fournisseur OAuth n'est activé en V1 ; le
/// modèle existe parce que l'adaptateur l'exige.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

/// Sessions Auth.js. Conservées bien que la stratégie soit JWT : l'adaptateur
/// les attend, et basculer en sessions de base ne demanderait alors qu'une
/// ligne de configuration.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Jeton de lien de connexion à usage unique (Auth.js).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

/// Tentative comptée pour la limitation de débit (revue §A2).
///
/// Chaque tentative est enregistrée, **y compris celles qui sont refusées** :
/// ne compter que les tentatives acceptées laisserait un script marteler
/// indéfiniment, puisque la fenêtre se viderait pendant qu'il frappe. Un
/// acharnement prolonge donc le blocage, ce qui est le comportement voulu.
///
/// Les lignes sont purgées par la route cron : sans purge, la table grossit
/// sans limite pour une information qui n'a de valeur que quelques minutes.
model RateLimitHit {
  id    String   @id @default(uuid())
  /// Périmètre limité (soumission de diagnostic, demande de lien de connexion).
  scope String
  /// Clé limitée, préfixée par sa nature : « ip:… » ou « email:… ».
  key   String
  at    DateTime @default(now())

  @@index([scope, key, at])
  @@index([at])
}

/// Une soumission de diagnostic. Racine de tout le reste.
model Assessment {
  id        String   @id
  createdAt DateTime

  /// Compte rattaché, quand la personne s'est connectée. Un diagnostic se
  /// soumet sans compte (CDC §12) : la colonne reste donc nullable.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Email dénormalisé depuis `answers`, indexé.
  ///
  /// C'est lui qui réalise la reprise du profil sans ressaisie du CDC §10 : à
  /// la première connexion, les diagnostics portant cette adresse et encore
  /// sans compte sont rattachés. Filtrer sur le JSON ferait le même travail
  /// sans index, et se casserait au premier renommage de champ.
  email String?

  /// Réponses brutes du questionnaire, figées (voir principe 1).
  answers Json
  /// Champs inférés au moment de la soumission.
  derived Json

  path       String
  textBlocks String[]

  partnerships Json
  costs        Json
  deadlines    Json

  /// Version exacte des règles utilisées — traçabilité CDC §14.1.
  rulesSnapshot Json

  /// Retrait du consentement marketing (CDC §34).
  ///
  /// Séparé de `answers.consentMarketing`, qui reste figé : cette réponse est
  /// la PREUVE de ce qui a été consenti, à la date où ça l'a été. L'écraser
  /// pour matérialiser un retrait effacerait cette preuve, et il deviendrait
  /// impossible de démontrer que le consentement avait bien été recueilli.
  /// Le consentement effectif est donc la réponse ET l'absence de retrait.
  unsubscribedAt DateTime?

  report       Report?
  taskStatuses TaskStatus[]
  scenarios    Scenario[]
  documents    Document[]
  notices      SentNotice[]
  milestones   MilestoneAward[]
  bookings     Booking[]
  entitlement  Entitlement?
  schools      SchoolChoice[]

  @@index([createdAt])
  @@index([email])
  @@index([userId])
}

/// Rapport en file (CDC §18) et sa revue avant envoi (CDC §17).
model Report {
  id           String   @id
  assessmentId String   @unique
  status       String
  priority     String
  createdAt    DateTime
  sentAt       DateTime?

  /// Fenêtre de déduction ouverte par le paiement (CDC §16.2).
  deduction Json?

  /// Points de revue traités. Identifiants dérivés du profil, recalculés à
  /// chaque affichage : un acquittement orphelin ne débloque jamais rien.
  acknowledged String[]

  assessment  Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  corrections Correction[]

  @@index([status, priority, createdAt])
}

/// Journal des corrections humaines (CDC §18 et §33).
model Correction {
  id       String   @id @default(uuid())
  reportId String
  at       DateTime
  author   String
  note     String

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, at])
}

/// Écart au statut initial d'une tâche. La feuille de route elle-même est
/// régénérée depuis les modèles : seuls les écarts sont persistés, ce qui
/// permet d'ajouter des tâches sans migration de données.
model TaskStatus {
  assessmentId String
  taskId       String
  status       String

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@id([assessmentId, taskId])
}

/// Scénario de coût (CDC §26). Seules les entrées sont conservées : les
/// sorties sont recalculées, sinon un scénario enregistré porterait un total
/// devenu faux après un changement de formule.
model Scenario {
  id           String @id
  assessmentId String
  inputs       Json

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

/// Pièce du coffre (CDC §29). Ni contenu ni index de contenu : le coffre range
/// des documents, il ne les lit pas.
model Document {
  id           String   @id
  assessmentId String
  type         String
  fileName     String
  sizeBytes    Int
  uploadedAt   DateTime
  /// Absent quand le stockage n'est pas configuré : la fiche existe, pas le fichier.
  storageKey   String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, type])
}

/// École de la liste de sélection (tâche T-SEL-03).
///
/// `ambition` et `status` restent des `String` porteurs d'unions fermées côté
/// TypeScript, comme partout ailleurs dans ce schéma : une enum Postgres exige
/// une migration pour ajouter une valeur, là où la liste du CDC doit pouvoir
/// évoluer avec le contenu.
///
/// `partnershipId` n'est PAS une clé étrangère : les accords vivent dans un
/// fichier généré, réimporté depuis un dépôt externe. Une contrainte
/// référentielle ferait échouer un import qui retire une fiche, alors que la
/// bonne conduite est de garder l'école choisie et de cesser d'afficher
/// l'accord.
model SchoolChoice {
  id                 String   @id
  assessmentId       String
  name               String
  partnershipId      String?
  ambition           String
  status             String
  /// Date limite notée par l'utilisateur, pas celle de l'accord : c'est la
  /// sienne qui l'engage, et elle peut différer du programme visé.
  applicationDeadline DateTime?
  notes              String?
  addedAt            DateTime

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

/// Événement produit (CDC §36) — compteur d'usage, sans aucun identifiant.
///
/// Volontairement dépourvu de toute colonne rattachable à une personne : ni
/// utilisateur, ni session, ni adresse IP, ni identifiant de passage. Deux
/// lignes du même visiteur sont indiscernables de deux lignes de deux
/// visiteurs — c'est ce qui permet de mesurer l'entonnoir sans détenir de
/// donnée personnelle.
///
/// `screen` n'est renseigné que pour `SCREEN_REACHED` : c'est lui qui produit
/// la courbe d'abandon, par différence entre compteurs successifs.
model ProductEvent {
  id     String   @id @default(uuid())
  kind   String
  screen String?
  at     DateTime @default(now())

  @@index([kind])
}

/// Révision d'une règle du Moteur A (CDC §33 — matrices éditables).
///
/// APPEND-ONLY : chaque modification crée une révision, rien n'est écrasé.
/// La règle effective est la dernière révision par-dessus la règle du code ;
/// `rulesSnapshot` continue de figer id + version dans chaque évaluation, et
/// la version effective est `version_code + révision` — la traçabilité du
/// CDC §14.1 survit donc à l'édition sans code.
///
/// Seules les MÉTADONNÉES sont éditables (activation, source, date de
/// vérification). La condition reste dans le code : une logique de règle se
/// teste, elle ne s'improvise pas depuis un formulaire.
model RuleRevision {
  ruleId     String
  revision   Int
  active     Boolean
  sourceUrl  String
  /// Date à laquelle le fondateur a confronté la règle à sa source.
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@id([ruleId, revision])
}

/// Révision d'un bloc de texte du rapport (CDC §33 — matrices éditables).
///
/// APPEND-ONLY, comme RuleRevision. Un rapport rouvert doit citer les blocs
/// tels qu'ils étaient à sa génération : l'assemblage résout les blocs « à la
/// date de l'évaluation » (dernière révision antérieure), ce qui rend le
/// gel automatique sans figer quoi que ce soit dans l'évaluation elle-même.
model BlockRevision {
  key       String
  revision  Int
  /// Contenu, dont la forme dépend du bloc (texte, titre+corps, risque).
  /// Validé par `decideBlockRevision` AVANT toute écriture.
  payload   Json
  createdAt DateTime @default(now())

  @@id([key, revision])
}

/// Rappel d'échéance déjà envoyé (CDC §22). La clé composée EST le mécanisme
/// d'idempotence : un second envoi du même rappel viole la contrainte.
model SentNotice {
  assessmentId String
  noticeId     String
  sentAt       DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@id([assessmentId, noticeId])
}

/// Première acquisition d'un Milestone Challenge (CDC §24). Seule la date est
/// stockée, jamais l'état : l'acquisition reste calculée depuis les tâches,
/// sinon un challenge resterait acquis après que le travail a été défait.
model MilestoneAward {
  assessmentId String
  milestone    String
  achievedAt   DateTime

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@id([assessmentId, milestone])
}

/// Créneau de consultation ouvert par le fondateur (CDC §31).
model ConsultationSlot {
  id       String   @id
  startsAt DateTime
  minutes  Int

  booking Booking?

  @@index([startsAt])
}

/// Séance réservée. `slotId` est unique : deux personnes ne peuvent pas tenir
/// le même créneau, et la base le refuse même si deux réservations arrivent
/// exactement en même temps.
model Booking {
  id           String   @id
  assessmentId String
  slotId       String   @unique
  type         String
  bookedAt     DateTime

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  slot       ConsultationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

/// Droit à consultation (CDC §31). `granted` est un entier : il n'existe pas
/// de valeur « illimité » à écrire, ici pas plus qu'en TypeScript.
model Entitlement {
  assessmentId String  @id
  offer        String?
  granted      Int     @default(0)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}
