# Variables d'environnement Admitto — copier en .env.local (jamais commité).
# Toutes sont optionnelles : sans elles, le produit fonctionne en mode Phase 1A
# (bêta gratuite, emails non expédiés, back-office fermé).

# ── Back-office (CDC §33) ───────────────────────────────────────────────────
# Sans ce jeton, /admin répond 404. Accès une fois par /admin?token=…
ADMITTO_ADMIN_TOKEN=

# ── URL publique, utilisée dans les liens des emails ────────────────────────
ADMITTO_BASE_URL=http://localhost:3000

# ── Emails (CDC §19) ────────────────────────────────────────────────────────
# Sans clé, le transport « console » journalise sans expédier : aucun risque
# d'envoi accidentel à un vrai destinataire en développement.
RESEND_API_KEY=
ADMITTO_EMAIL_FROM=

# ── Paiement (CDC §16.2, Phase 1B) ──────────────────────────────────────────
# Sans clé secrète, le paiement reste désactivé et le diagnostic est offert
# (phase bêta). Le webhook est inerte tant que son secret n'est pas défini :
# une confirmation de paiement non signée ne doit jamais avoir d'effet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
